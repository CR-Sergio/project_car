{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "project-car",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "proyect_car_db",
      "database_id": "2c5b39f9-f68c-418d-8f16-81fc01924da7"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "proyect-car-assets"
    }
  ],
  "vars": {
    "PAYPAL_ME_USER": "proyectcar"
  }
}